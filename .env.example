# Sanity (public — safe to expose client-side)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19

# Sanity write token — server only, used by /api/admin/* routes
SANITY_WRITE_TOKEN=

# Admin panel (/admin) — single shared password + HMAC session signing key
ADMIN_PASSWORD=
SESSION_SECRET=
